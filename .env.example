DATABASE_URL=postgresql+psycopg://platform:platform@postgres:5432/ai_data_platform
RAW_STORAGE_PATH=/data/raw
CURATED_STORAGE_PATH=/data/curated
LOG_LEVEL=INFO
MAX_EVENT_SIZE_BYTES=65536
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=agent-events.v1
KAFKA_CONSUMER_GROUP=ai-data-platform-streaming-v1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-data-platform-api
API_KEY=replace-with-a-long-random-development-key
EVALUATION_STORAGE_PATH=/data/evaluations
OBJECT_STORE_ENDPOINT=http://localhost:4566
OBJECT_STORE_ACCESS_KEY=test
OBJECT_STORE_SECRET_KEY=test
OBJECT_STORE_BUCKET=ai-data-platform
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=ai_data_platform
CLICKHOUSE_USERNAME=platform
CLICKHOUSE_PASSWORD=platform
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
